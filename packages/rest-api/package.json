{
  "name": "rest-api",
  "version": "0.0.0",
  "description": "Package with rest-api endpoints for current monorepo",
  "exports": {
    "./lib/avatar-url": {
      "types": "./dist/lib/avatar-url.d.ts",
      "import": "./dist/lib/avatar-url.mjs",
      "require": "./dist/lib/avatar-url.js"
    },
    "./types/domains": "./dist/types/domains.d.ts",
    "./types/filters": "./dist/types/filters.d.ts",
    "./types/requests": "./dist/types/requests.d.ts",
    "./env": {
      "types": "./dist/const/api.d.ts",
      "import": "./dist/const/api.mjs",
      "require": "./dist/const/api.js"
    },
    "./requests": {
      "types": "./dist/rest/requests/requests.d.ts",
      "import": "./dist/rest/requests/requests.mjs",
      "require": "./dist/rest/requests/requests.js"
    },
    "./domains": {
      "types": "./dist/rest/domains/domains.d.ts",
      "import": "./dist/rest/domains/domains.mjs",
      "require": "./dist/rest/domains/domains.js"
    },
    "./indexing": {
      "types": "./dist/rest/indexing/indexing.d.ts",
      "import": "./dist/rest/indexing/indexing.mjs",
      "require": "./dist/rest/indexing/indexing.js"
    },
    "./search": {
      "types": "./dist/rest/search/search.d.ts",
      "import": "./dist/rest/search/search.mjs",
      "require": "./dist/rest/search/search.js"
    },
    "./snippets": {
      "types": "./dist/rest/snippets/snippets.d.ts",
      "import": "./dist/rest/snippets/snippets.mjs",
      "require": "./dist/rest/snippets/snippets.js"
    },
    "./filters": {
      "types": "./dist/rest/search/filters.d.ts",
      "import": "./dist/rest/search/filters.mjs",
      "require": "./dist/rest/search/filters.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "publish": "bun run build",
    "build": "tsup",
    "dev": "tsup --watch --clean=false"
  },
  "keywords": [
    "package",
    "rest-api"
  ],
  "author": "YZ13-dev",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "typescript": "^5.8.3",
    "db": "*"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "next": "^15.3.0",
    "tsup": "^6.7.0",
    "typescript-config": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
