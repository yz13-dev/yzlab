          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "pathname",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Get all sites links",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/domain"
                }
              }
            }
