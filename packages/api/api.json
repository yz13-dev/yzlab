  "paths": {
    "/v1/links": {
      "post": {
        "operationId": "createLink",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "links",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "domain",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Get all sites links",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/sites"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/sites"
                }
              }
            }
          }
        }
      }
    },
    "/v1/links/count/increase": {
