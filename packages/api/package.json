{
  "name": "@yzlab/api",
  "version": "0.0.0",
  "description": "Package with @yzlab/api endpoints for current monorepo",
  "exports": {
    "./lib/avatar-url": {
      "types": "./dist/lib/avatar-url.d.ts",
      "import": "./dist/lib/avatar-url.mjs",
      "require": "./dist/lib/avatar-url.js"
    },
    "./types": "./dist/types/index.d.ts",
    ".": {
      "types": "./dist/api/yzlab-api.d.ts",
      "import": "./dist/api/yzlab-api.mjs",
      "require": "./dist/api/yzlab-api.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "publish": "bun run build",
    "build": "tsup",
    "dev": "tsup --watch --clean=false",
    "api:fetch": "bun run generate-api",
    "api:generate": "rimraf src/api && rimraf src/types && orval",
    "api:update": "bun run api:fetch && bun run api:generate"
  },
  "keywords": [
    "package",
    "@yzlab/api"
  ],
  "author": "YZ13-dev",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "typescript": "^5.8.3",
    "@yzlab/supabase": "*"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "date-fns": "^4.1.0",
    "next": "^15.3.0",
    "orval": "^7.9.0",
    "tsup": "^6.7.0",
    "typescript-config": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
